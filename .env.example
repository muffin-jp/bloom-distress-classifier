# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Only the two scripts that call the API read this — scripts/propose_labels.py
# and scripts/generate_candidates.py. Everything else in this repo is offline.
#
# Alternative: run `ant auth login` once and leave this unset. The SDK resolves
# credentials in order: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, then the
# active `ant` profile.
ANTHROPIC_API_KEY=
